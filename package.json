{
  "name": "run-hub-root",
  "private": true,
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.10.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter frontend run dev",
    "build": "pnpm --filter frontend run build",
    "preview": "pnpm --filter frontend run preview",
    "fetch": "pnpm --filter scripts run fetch",
    "typecheck": "pnpm --filter frontend run typecheck",
    "typecheck:scripts": "pnpm --filter scripts run typecheck",
    "test:scripts": "pnpm --filter scripts run test",
    "local-test": "bash scripts/local-test.sh"
  }
}
