{
  "name": "frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "error"
    }
  },
  "description": "Personal frontend-only website that displays running logs from intervals.icu.",
  "scripts": {
    "copy-data": "node -e \"require('fs').cpSync('../data','public/data',{recursive:true})\"",
    "dev": "pnpm run copy-data && vite",
    "build": "pnpm run copy-data && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@deck.gl/core": "^9.4.0",
    "@deck.gl/geo-layers": "^9.4.0",
    "@deck.gl/layers": "^9.4.0",
    "@deck.gl/mapbox": "^9.4.0",
    "@deck.gl/react": "^9.4.0",
    "gsap": "^3.15.0",
    "maplibre-gl": "^5.24.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-map-gl": "^8.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  }
}
